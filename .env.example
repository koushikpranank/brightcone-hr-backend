# Copy to .env (git-ignored). These are DEVELOPMENT values only. Never reuse them in production.

# --- used by docker compose on first start ---
POSTGRES_PASSWORD=postgres
MIGRATOR_PASSWORD=migrator_dev_pw
RUNTIME_PASSWORD=runtime_dev_pw
QUEUE_PASSWORD=queue_dev_pw

# --- used by the app ---
# The running app connects as app_runtime (cannot change table structure)
DATABASE_URL=postgres://app_runtime:runtime_dev_pw@localhost:5432/brightcone_dev
# The job queue has its own role and schema (Loco creates its queue tables at start-up)
QUEUE_URL=postgres://app_queue:queue_dev_pw@localhost:5432/brightcone_dev
# Migrations connect as app_migrator (make migrate)
MIGRATION_DATABASE_URL=postgres://app_migrator:migrator_dev_pw@localhost:5432/brightcone_dev
# Tests use their own database and WIPE it. Never point this at the dev database.
TEST_DATABASE_URL=postgres://app_migrator:migrator_dev_pw@localhost:5432/brightcone_test

JWT_SECRET=dev-only-secret-never-use-in-production
LOG_LEVEL=debug
MAILER_HOST=localhost
